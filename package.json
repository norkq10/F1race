{
  "name": "f1race",
  "private": true,
  "version": "0.6.0",
  "description": "F1race - 像素风 2D 俯视单机赛车（M1 可驾驶 → M2 计时 → M3 漂移 → M4 幽灵车 → M5 AI 与排名与结算 → M6 打磨与对抗）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tools/ts-register.mjs --test \"tests/**/*.test.ts\"",
    "gen:assets": "node tools/gen-assets.mjs && node tools/gen-track.mjs",
    "preview:assets": "node tools/preview-assets.mjs",
    "e2e": "node tools/e2e-check.mjs",
    "check:tracks": "node tools/check-tracks.mjs",
    "doc:stats": "node tools/doc-stats.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:tracks && npm run e2e"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
